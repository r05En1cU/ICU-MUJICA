# docker/Dockerfile.evaluate
FROM python:3.11-slim-bullseye

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/ICU-MUJICA

# 1. 安装基础工具与 EDA 工具链
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    curl \
    iverilog \
    make \
    && rm -rf /var/lib/apt/lists/*

# 2. 设置工作目录与共享空间
WORKDIR /ICU-MUJICA
RUN mkdir -p /ICU-MUJICA/shared_workspace /ICU-MUJICA/output /ICU-MUJICA/src && chmod -R 777 /ICU-MUJICA

# 3. 安装 Python 依赖
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 4. 放宽运行所需执行权限
RUN chmod -R a+rX /usr/local/lib/python3.11/site-packages
RUN chmod -R a+rx /usr/local/bin/

# 5. 拷贝评估逻辑
COPY ./src /ICU-MUJICA/src

# 6. 启动 FastAPI 服务 (Evaluate 接口)
# 用 --workers 2 限制并发验证任务数
WORKDIR /ICU-MUJICA
ENV PYTHONPATH=/ICU-MUJICA
CMD ["uvicorn", "src.verify.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]